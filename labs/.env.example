AWS_REGION=ap-northeast-1

# For AWS Bedrock, need exact match variable name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model IDs use dots: provider.model-id:version
# Nova models need an inference profile prefix (jp. / apac. / global.), not the raw ID.
BEDROCK_CONVERSATION_MODEL_ID=jp.amazon.nova-2-lite-v1:0
BEDROCK_JUDGE_MODEL_ID=apac.amazon.nova-pro-v1:0

# Drafter for gold-set candidates: a non-Amazon family (Claude / Gemini / GPT are
# blocked in this region). Must support the Converse API. Verified in ap-northeast-1:
# mistral.mistral-large-3-675b-instruct, qwen.qwen3-235b-a22b-2507-v1:0, zai.glm-4.7-flash
BEDROCK_DRAFTER_MODEL_ID=mistral.mistral-large-3-675b-instruct
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
